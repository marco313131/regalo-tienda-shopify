<style>
  @keyframes tp-subir { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
  @keyframes tp-zoom { from { transform: scale(1.12); } to { transform: scale(1); } }
  @media (prefers-reduced-motion: no-preference) {
    .hero .hero__media-grid img { animation: tp-zoom 2.4s cubic-bezier(.2,.7,.2,1) both; }
    .hero .hero__content-wrapper > * { animation: tp-subir .9s cubic-bezier(.2,.7,.2,1) both; }
    .hero .hero__content-wrapper > *:nth-child(2) { animation-delay: .12s; }
    .hero .hero__content-wrapper > *:nth-child(3) { animation-delay: .24s; }
    .hero .hero__content-wrapper > *:nth-child(4) { animation-delay: .36s; }
    html.tp-anima .tp-oculto { opacity: 0; transform: translateY(36px); }
    html.tp-anima .tp-oculto.tp-visible { opacity: 1; transform: none; transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); transition-delay: var(--tp-retraso, 0s); }
  }
  .resource-list__item img { transition: transform .5s cubic-bezier(.2,.7,.2,1); }
  .resource-list__item:hover img { transform: scale(1.04); }
</style>
<script>
  (function () {
    if (!('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (window.Shopify && window.Shopify.designMode) return;
    var raiz = document.documentElement;
    raiz.classList.add('tp-anima');
    var ver = new IntersectionObserver(function (entradas) {
      entradas.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('tp-visible'); ver.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
    function marcar() {
      var secciones = document.querySelectorAll('main .shopify-section:not(:first-child)');
      secciones.forEach(function (s) {
        var items = s.querySelectorAll('.resource-list__item');
        var objetivos = items.length ? items : [s];
        Array.prototype.forEach.call(objetivos, function (el, i) {
          if (el.classList.contains('tp-oculto')) return;
          el.style.setProperty('--tp-retraso', (items.length ? (i % 4) * 0.09 : 0) + 's');
          el.classList.add('tp-oculto');
          ver.observe(el);
        });
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', marcar); else marcar();
  })();
</script>
